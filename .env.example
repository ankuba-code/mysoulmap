# .env.example — Platzhalter, echte Werte nur in .env
OPENAI_API_KEY=
# Leer lassen: Chat wird nicht an Langfuse gesendet
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_URL=
BOOKING_AFFILIATE_ID=
MYSQL_HOST=db
MYSQL_DATABASE=soulmap
MYSQL_USER=soulmap
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# bcrypt-Hash als Hex-String, damit Compose kein $ interpoliert
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
DATABASE_URL=
# Leer lassen: Dateien aus python backend/scripts/update_geoip.py
GEOIP_DB_PATH=
GEOIP_CITY_DB_PATH=
CORS_ORIGIN=
# Post-Monitoring: Empfänger der Alarm-Mails und SMTP (Gmail-App-Passwort)
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MONITOR_TOKEN=
REDIS_URL=
GLOBAL_DAILY_TOKEN_LIMIT=500000
GLOBAL_HOURLY_TOKEN_LIMIT=
GLOBAL_LLM_CALLS_PER_MINUTE=30
